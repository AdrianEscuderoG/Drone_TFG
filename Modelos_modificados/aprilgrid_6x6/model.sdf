<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="aprilgrid_6x6">
    <!--
      Panel estático. Convención local del link:
        eje X = normal del panel (dirección en la que "mira" el AprilGrid)
        eje Y = ancho  (0.648 m)
        eje Z = alto   (0.648 m)
      Al incluir este modelo en el world, rota <pose> según hacia dónde
      quieras que mire el panel (p.ej. si está pegado a una pared en el
      plano Y-Z del mundo, orienta el eje X local hacia el interior de la sala).

      Tamaño físico y parámetros de detección (tagSize, spacing, etc.)
      documentados en aprilgrid_6x6.json — deben coincidir siempre con
      esta geometría si se regenera la textura.
    -->
    <static>true</static>

    <link name="panel_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="panel_visual">
        <geometry>
          <box>
            <size>0.02 0.648 0.648</size>
          </box>
        </geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://aprilgrid_6x6/materials/textures/aprilgrid_6x6.png</albedo_map>
              <emissive_map>model://aprilgrid_6x6/materials/textures/aprilgrid_6x6.png</emissive_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="panel_collision">
        <geometry>
          <box>
            <size>0.02 0.648 0.648</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
  </model>
</sdf>
